    {
      "parameters": {
        "jsCode": "const request = $input.first();\nconst raw = request.binary?.data ? await this.helpers.getBinaryDataBuffer(0, 'data') :\n  (request.json.body?.type === 'Buffer' ? Buffer.from(request.json.body.data) :\n    typeof request.json.body === 'string' ? Buffer.from(request.json.body) : null);\nconst mock = $env.MOCK_INTEGRATIONS !== 'false';\nlet ok = mock;\nif (!mock && raw && $env.META_APP_SECRET) {\n  const crypto = require('crypto');\n  const expected = 'sha256=' + crypto.createHmac('sha256', $env.META_APP_SECRET).update(raw).digest('hex');\n  const received = String(request.json.headers?.['x-hub-signature-256'] || '');\n  ok = /^sha256=[a-f0-9]{64}$/.test(received) && received.length === expected.length && crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\n}\nif (!ok) return [{ json: { ok: false } }];\nconst body = raw ? JSON.parse(raw.toString('utf8')) : request.json.body;\nconst events = [];\nif (body?.object === 'page') for (const entry of body.entry || []) for (const event of entry.messaging || []) {\n  const message = event.message;\n  const psid = String(event.sender?.id || '');\n  if ((!message?.mid && !event.postback) || message?.is_echo || event.read || event.delivery || !/^\\d{1,40}$/.test(psid)) continue;\n  events.push({ mid: String(message?.mid || event.postback?.mid || (psid + '-postback-' + event.timestamp)).slice(0, 200), psid,\n    ...(message?.sticker_id ? { attachmentType: 'sticker' } : message?.attachments?.length ? { attachmentType: ['image', 'location'].includes(message.attachments[0].type) ? message.attachments[0].type : 'other' } : {}),\n    text: String(message?.quick_reply?.payload || message?.text || event.postback?.payload || '').slice(0, 2000) });\n}\nreturn [{ json: { ok: true, events } }];"
      },
