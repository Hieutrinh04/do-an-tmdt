      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Đọc và kiểm tra đơn đã lưu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "notes": "Kiểm tra dòng hàng, tổng tiền và dữ liệu đơn đã commit. Kho đã được giữ khi chốt đơn.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const order = $input.first().json;\nconst event = $('Webhook · Đơn mới').first().json.body;\nconst status = event.status;\nconst labels = {PENDING:'Chờ xác nhận',CONFIRMED:'Đã xác nhận',SHIPPING:'Đang giao',DELIVERED:'Đã giao',CANCELLED:'Đã hủy'};\nif (!labels[status]) throw new Error('Trạng thái sự kiện không hợp lệ.');\nconst esc = value => String(value ?? '').replace(/[&<>\"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[char]));\nconst money = value => new Intl.NumberFormat('vi-VN', {style:'currency',currency:'VND'}).format(value);\nconst row = {code:order.code,createdAt:order.createdAt,customer:order.customerName,phone:order.phone,address:order.address,\n  products:order.items.map(item => item.productName + ' · ' + item.color + ' / ' + item.size + ' / ' + item.gender + ' × ' + item.quantity + ' ' + item.unit).join('; '),\n  quantity:order.items.reduce((sum,item) => sum+item.quantity,0),subtotal:order.subtotal,shippingFee:order.shippingFee,\n  gender:order.items.map(item => item.gender).join('; '),packingFee:order.packingFee,\n  hasLiveFish:order.hasLiveFish ? 'Có' : 'Không',preferredDelivery:order.preferredDelivery,deliveryNote:order.note,\n  total:order.total,paymentMethod:order.paymentMethod,paymentStatus:order.paymentStatus,status};\nconst site = ($env.SITE_URL || 'http://localhost:8080').replace(/\\/+$/, '');\nconst url = site + '/track?code=' + encodeURIComponent(order.code);\nconst method = order.paymentMethod === 'BANK_QR' ?\n  'Chuyển khoản đúng ' + money(order.total) + ', nội dung ' + order.code + (order.qrUrl ? '\\nQR: ' + order.qrUrl : '') :\n  'Thanh toán khi nhận hàng.';\nconst policy = order.hasLiveFish ? '\\n' + order.doaPolicy : '';\nconst newText = 'Long Fish đã nhận đơn ' + order.code + '.\\n' + row.products + '\\nTổng: ' + money(order.total) + '.\\n' + method;\nconst statusText = 'Long Fish · Đơn ' + order.code + ' · ' + labels[status] + '.';\nconst htmlRows = order.items.map(item => '<tr><td>' + esc(item.productName) + '</td><td>' + esc(item.color) + ' / ' +\n  esc(item.size) + ' / ' + esc(item.gender) + '</td><td>' + item.quantity + ' ' + esc(item.unit) + '</td><td>' + esc(money(item.unitPrice * item.quantity)) + '</td></tr>').join('');\nconst html = '<h2>Long Fish · Đơn mới ' + esc(order.code) + '</h2><p>' + esc(order.customerName) + ' · ' + esc(order.phone) +\n  '<br>' + esc(order.address) + '</p><table border=\"1\" cellpadding=\"8\"><tr><th>Sản phẩm</th><th>Phân loại</th><th>SL</th><th>Tiền hàng</th></tr>' +\n  htmlRows + '</table><p>Tiền hàng ' + money(order.subtotal) + ' · Giao hàng ' + money(order.shippingFee) + ' · Đóng gói ' + money(order.packingFee) +\n  ' · Tổng ' + money(order.total) + '</p><p>' + esc(order.paymentMethod) + '</p><p>Cá sống: ' + row.hasLiveFish + '<br>Nhận mong muốn: ' +\n  esc(order.preferredDelivery ? new Date(order.preferredDelivery).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'}) : '') +\n  '<br>Ghi chú: ' + esc(order.note) + '</p>';\nreturn [{ json: {row, subject:'[Long Fish] Đơn mới ' + order.code, html, psid:order.psid,\n  message:{text:(true ? newText.slice(0,1300) + policy : statusText + (status === 'SHIPPING' ? policy : '')) + '\\nTra cứu: ' + url.toString()} } }];"
      },
