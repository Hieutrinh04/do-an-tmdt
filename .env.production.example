# Required: hostname only, no scheme/path. Do not use example values as secrets.
PUBLIC_DOMAIN=shop.example.com
ACME_EMAIL=owner@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
# Start mock during infrastructure checks; false only after integration credentials work.
MOCK_INTEGRATIONS=true
SEED_DEMO=false
DATABASE_URL=file:/data/store.db
# Derived by production override; shown here for external tools.
PUBLIC_BASE_URL=https://shop.example.com
SITE_URL=https://shop.example.com
FRONTEND_ORIGIN=https://shop.example.com
WEBHOOK_URL=https://shop.example.com/
N8N_SECURE_COOKIE=true
# Required for real Messenger; never commit actual values.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# Required for real Sheets/email; configure n8n credentials separately.
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Required for receiving actual bank transfers.
VIETQR_BANK=
VIETQR_ACCOUNT=
VIETQR_ACCOUNT_NAME=
# Optional auto-reconciliation webhook; enable only after the bank service is configured.
BANK_WEBHOOK_SECRET=
# Optional: use only for tunnel profile; route hostname to http://gateway:80.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional bot/shop configuration, Vietnam timezone; weekdays 1=Mon ... 7=Sun.
SHOP_OPEN_DAYS=1,2,3,4,5,6,7
SHOP_OPEN_HOUR=8
SHOP_CLOSE_HOUR=21
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini
PEXELS_API_KEY=
PIXABAY_API_KEY=
