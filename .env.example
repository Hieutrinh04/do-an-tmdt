# Long Fish
SHOP_NAME=Long Fish
# Máy local và Docker dùng chung file .env (sao chép file này trước).
PORT=3001
FRONTEND_ORIGIN=http://localhost:8080
SITE_URL=http://localhost:8080
# Đặt URL HTTPS công khai của website khi dùng Messenger thật.
PUBLIC_BASE_URL=
IMAGE_CONTACT_EMAIL=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Bỏ chú thích để đổi DB. SQLite mặc định: file:./long-fish.db.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
SEED_DEMO=true
ADMIN_USERNAME=admin
# Tự đặt mật khẩu ≥ 12 ký tự. Compose demo tự sinh khi để trống.
ADMIN_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
N8N_WEBHOOK_SECRET=
MOCK_INTEGRATIONS=true
# Số đơn tối đa mỗi IP mỗi phút (mặc định 20).
ORDER_RATE_LIMIT=20
N8N_ORDER_CREATED_WEBHOOK=http://n8n:5678/webhook/order-created
N8N_ORDER_STATUS_WEBHOOK=http://n8n:5678/webhook/order-status
SHIPPING_FREE_THRESHOLD=600000
SHIPPING_DEFAULT_FEE=35000
SHIPPING_FEES_JSON='{"Hồ Chí Minh":20000,"Hà Nội":30000,"Đà Nẵng":30000}'
LIVE_FISH_PROVINCES_JSON='["*"]'
LIVE_FISH_PACKING_FEE=30000
# Điền BIN/tên ngân hàng và số tài khoản nhận thanh toán của Long Fish.
VIETQR_BANK=
VIETQR_ACCOUNT=
VIETQR_ACCOUNT_NAME=
# Secret để đối soát chuyển khoản tự động qua POST /api/payments/bank (header x-bank-secret).
BANK_WEBHOOK_SECRET=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# Tự nhắn riêng (Private Reply) cho người bình luận dưới bài viết của Page.
# COMMENT_KEYWORDS: các từ khóa cách nhau bằng dấu phẩy (không phân biệt dấu); để trống = trả lời mọi bình luận.
COMMENT_AUTOREPLY_ENABLED=true
COMMENT_KEYWORDS=
COMMENT_MAX_PER_HOUR=60
# Dự phòng khi Meta không gửi webhook bình luận: backend tự quét bình luận mới dưới các bài gần nhất (cần pages_read_user_content).
COMMENT_POLL_ENABLED=true
COMMENT_POLL_SECONDS=60
COMMENT_POLL_POSTS=10
COMMENT_POLL_LOOKBACK_MINUTES=30
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
GOOGLE_SHEET_ID=
# Đường dẫn JSON Service Account trên máy dùng scripts/sheets:init.
GOOGLE_APPLICATION_CREDENTIALS=
# Các biến SMTP dùng cho check:integrations. Cấu hình cùng thông tin trong credential SMTP của n8n.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
N8N_ENCRYPTION_KEY=
# Bật true khi truy cập trình biên tập qua HTTPS.
N8N_SECURE_COOKIE=false
# Public HTTPS URL của n8n. Mặc định Docker dùng localhost.
# WEBHOOK_URL=https://automation.example.com/
CHECK_BASE_URL=http://127.0.0.1:8080
CHECK_N8N_URL=http://127.0.0.1:5678
BACKUP_DIR=data/backups



# Đường dẫn thư mục upload khi chạy backend local. Docker dùng volume riêng.
# UPLOADS_DIR=./data/uploads
# Giờ hỗ trợ, Asia/Ho_Chi_Minh; ngày 1=Thứ Hai ... 7=Chủ nhật.
SHOP_OPEN_DAYS=1,2,3,4,5,6,7
SHOP_OPEN_HOUR=8
SHOP_CLOSE_HOUR=21
